# Vercel Webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
GITHUB_TOKEN=
GITHUB_REPOSITORY=C0verSnow/LearnWords
GITHUB_REF=main
MAX_CARDS=100

# Actions secrets / optional local session experiments
TELEGRAM_CHAT_ID=
CHROME_PATH=
SESSION_FILE=.session/deepseek.json
# none / cookies / web_storage / profile; enable only after the session experiment
SESSION_MODE=profile
# Optional private Supabase Storage object (no business tables)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SESSION_BUCKET=browser-sessions
SUPABASE_SESSION_OBJECT=deepseek.json
SUPABASE_PROFILE_OBJECT=deepseek-profile.tar.gz

# Private mihomo subscription; runner reads proxy/subscription.json from the private bucket
MIHOMO_SUBSCRIPTION_URL=
BROWSER_PROXY=

# All browser workflows use the Hong Kong TUN
MIHOMO_TUN=1
